#: src/kasasa-application.c:539
msgid ""
"Capture modes:\n"
"  kasasa                              Select a screen region to capture\n"
"  kasasa --screencast                 Select a Hyprland window to preview "
"live\n"
"  kasasa --window=active              Capture the active Hyprland window\n"
"  kasasa --screencast --monitor=active\n"
"                                      Capture the active Hyprland monitor "
"live\n"
"\n"
"Use --list-windows or --list-monitors to inspect Hyprland capture targets.\n"
"Native monitor capture requires --monitor together with --screencast."
msgstr ""
"捕获方式：\n"
"  kasasa                              选择屏幕区域截图\n"
"  kasasa --screencast                 选择一个 Hyprland 窗口实时预览\n"
"  kasasa --window=active              捕获当前 Hyprland 窗口\n"
"  kasasa --screencast --monitor=active\n"
"                                      实时捕获当前 Hyprland 显示器\n"
"\n"
"使用 --list-windows 或 --list-monitors 查看 Hyprland 捕获目标。\n"
"原生显示器捕获需要同时使用 --monitor 和 --screencast。"

