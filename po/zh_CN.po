msgstr "--json 需要与 --list-windows 一起使用"

msgid ""
"Snip and pin useful information\n"
"\n"
"If you liked the app ❤️, consider giving it a star ⭐:"
msgstr ""
"截取并贴置有用的信息\n"
"\n"
"如果您喜欢这个应用 ❤️，欢迎为它点亮一颗星 ⭐："

msgid "translator-credits"
